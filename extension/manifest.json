{
  "manifest_version": 3,
  "name": "WB Seller Audit Capture",
  "version": "0.2.1",
  "description": "Audit WB sellers from public catalog data or captured MPStats JSON.",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://*.mpstats.io/*",
    "https://mpstats.io/*",
    "https://catalog.wb.ru/*",
    "https://apix.chillcreative.ru/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.mpstats.io/*", "https://mpstats.io/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.mpstats.io/*", "https://mpstats.io/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "WB Seller Audit",
    "default_popup": "popup.html"
  }
}
