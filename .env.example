# Скопируйте в .env и подставьте реальные значения (не коммитите .env!)

# MPStats — direct API integration
MPSTATS_TOKEN=
MPSTATS_API_BASE_URL=https://mpstats.io/api/analytics/v1/wb
MPSTATS_API_ROOT_URL=https://mpstats.io/api
MPSTATS_TIMEOUT_SECONDS=30
MPSTATS_MAX_RETRIES=4
MPSTATS_RETRY_BASE_SECONDS=1

# DeepSeek — semantic SKU classification
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
